    keywords = {\_My Publications},
    language = {en},
    month = {22~May},
    number = {1},
    pages = {3803},
    pdf = {https://www.nature.com/articles/s41467-024-48153-z.pdf},
    pmid = {38778015},
    preprint_doi = {10.1101/798017},
    preview = {Duarte2024-lg_fig1.webp},
    publisher = {Springer Science and Business Media LLC},
    title = {Integrating human endogenous retroviruses into transcriptome-wide
