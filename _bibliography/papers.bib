    number = {1708501},
    pages = {1708501},
    pdf = {https://public-pages-files-2025.frontiersin.org/journals/oncology/articles/10.3389/fonc.2026.1708501/pdf},
    publisher = {Frontiers Media SA},
    title = {Human endogenous retrovirus profiling reveals heterogenous
expression in cutaneous melanoma},
