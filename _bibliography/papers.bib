    html = {https://doi.org/10.1016/j.meegid.2020.104277},
    journal = {Infect. Genet. Evol.},
    keywords = {Fast-evolving viruses; HIV; Haplotype reconstruction; Intra-host
diversity; Next-generation sequencing; Simulations;\_My
Publications},
    language = {en},
    month = {August},
    number = {104277},
    pages = {104277},
    pmid = {32151775},
